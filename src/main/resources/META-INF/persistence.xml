<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">
    <persistence-unit name="logisticsPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>com.mycompany.logistic.model.AppUser</class>
        <class>com.mycompany.logistic.model.Shipment</class>
        <class>com.mycompany.logistic.model.ShipmentEvent</class>
        <class>com.mycompany.logistic.model.InventoryItem</class>
        <class>com.mycompany.logistic.model.CustomerOrder</class>
        <class>com.mycompany.logistic.model.Vehicle</class>
        <class>com.mycompany.logistic.model.Driver</class>
        <class>com.mycompany.logistic.model.Warehouse</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>
        <properties>
            <property name="hibernate.hbm2ddl.auto" value="validate"/>
            <property name="hibernate.show_sql" value="false"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>
